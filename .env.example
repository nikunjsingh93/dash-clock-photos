# Copy to .env and choose a long, unique password before the first start.
DASH_ADMIN_USERNAME=admin
DASH_ADMIN_PASSWORD=replace-this-with-a-long-unique-password
# Absolute path of the mounted HDD photo root on Ubuntu.
DASH_PHOTOS_PATH=/mnt/photos/dash-clock
# Local SSD/ext4 directory for account state.
DASH_STATE_PATH=/var/lib/dash-clock-photos
DASH_PORT=3080
