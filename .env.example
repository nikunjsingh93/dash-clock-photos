# Copy to .env and choose a unique password of at least 8 characters before the first start.
DASH_ADMIN_USERNAME=admin
DASH_ADMIN_PASSWORD=replace-this-with-a-long-unique-password
DASH_PORT=3080
# Local compose.yaml uses ./photos and ./state by default.
# For an Ubuntu HDD/Portainer deployment, set these host mount paths in the stack:
# DASH_PHOTOS_PATH=/mnt/photos/dash-clock
# DASH_STATE_PATH=/var/lib/dash-clock-photos
